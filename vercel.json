{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "",
  "outputDirectory": "frontend",
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "node_modules/pdfkit/js/data/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    { "source": "/product", "destination": "/product.html" },
    { "source": "/contact", "destination": "/contact.html" },
    { "source": "/shipping-policy", "destination": "/shipping-policy.html" },
    { "source": "/returns", "destination": "/returns.html" },
    { "source": "/about", "destination": "/about.html" },
    { "source": "/careers", "destination": "/careers.html" },
    { "source": "/events", "destination": "/events.html" }
  ]
}
