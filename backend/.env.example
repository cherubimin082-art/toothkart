PORT=4000
JWT_SECRET=replace-with-a-long-random-string
ADMIN_EMAIL=admin@toothkart.com
ADMIN_PASSWORD=choose-a-strong-password

# Mobile OTP login: console (prints the code in the server window) or twilio (sends a real SMS)
SMS_PROVIDER=console
SHOW_OTP_IN_RESPONSE=false
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
# 2Factor.in (set SMS_PROVIDER=2factor above, then fill these in)
# TWOFACTOR_API_KEY=
# TWOFACTOR_TEMPLATE_NAME=
